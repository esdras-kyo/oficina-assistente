{
  "_comentario": [
    "expressoes = regex aplicada ANTES, para o que é multi-palavra.",
    "termos = corrigidos por distância de edição, palavra a palavra.",
    "CALIBRE o limiar com suas 30 frases gravadas. Corrigir demais",
    "é muito pior que corrigir de menos: se virar 'carro' em 'cárter',",
    "você quebrou o app."
  ],

  "expressoes": [
    { "padrao": "cinco\\s+(duplo\\s+v[êe]|dubl[êe]|w)\\s+trinta", "substituto": "5W-30" },
    { "padrao": "dez\\s+(duplo\\s+v[êe]|dubl[êe]|w)\\s+quarenta",  "substituto": "10W-40" },
    { "padrao": "quinze\\s+(duplo\\s+v[êe]|dubl[êe]|w)\\s+quarenta","substituto": "15W-40" },
    { "padrao": "vinte\\s+(duplo\\s+v[êe]|dubl[êe]|w)\\s+cinquenta","substituto": "20W-50" },
    { "padrao": "luz\\s+d[oa]\\s+motorzinho",                      "substituto": "luz da injeção" },
    { "padrao": "luz\\s+d[oa]\\s+motor\\b",                        "substituto": "luz da injeção" },
    { "padrao": "chave\\s+de\\s+(dezessete|desete)",               "substituto": "chave de 17 mm" },
    { "padrao": "chave\\s+de\\s+(treze|treis)",                    "substituto": "chave de 13 mm" },
    { "padrao": "chave\\s+de\\s+(dezenove|deznove)",               "substituto": "chave de 19 mm" },
    { "padrao": "sonda\\s+(lambida|lambda|lamba)",                 "substituto": "sonda lambda" },
    { "padrao": "correia\\s+(dentada|dentado|dentaria)",           "substituto": "correia dentada" },
    { "padrao": "\\bagua\\s+d[oa]\\s+radiador\\b",                 "substituto": "líquido de arrefecimento" },
    { "padrao": "\\bcheck\\s*engine\\b",                           "substituto": "luz da injeção" }
  ],

